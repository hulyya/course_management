        <mxCell id="pgUvCwgqiw09msVsI5Re-517" parent="1" style="shape=actor;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="120" width="100" x="5782.15" y="-195" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-520" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=1" value="Admin" vertex="1">
          <mxGeometry height="40" width="150" x="5930" y="-210" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-521" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Plant und verwaltet alles rund um die Kurse." vertex="1">
          <mxGeometry height="40" width="360" x="5930" y="-180" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-522" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5770" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-524" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Kurse anlegen, ändern und verwalten." vertex="1">
          <mxGeometry height="40" width="282.85" x="5776.08" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-525" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6070" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-526" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="User Story" vertex="1">
          <mxGeometry height="40" width="112.15" x="5770" y="-60" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-527" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Akzeptanzkriterien" vertex="1">
          <mxGeometry height="40" width="130" x="6070" y="-60" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-528" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Titel und Beschreibung sind Pflicht.&amp;nbsp;" vertex="1">
          <mxGeometry height="40" width="295" x="6070" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-534" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="5770" y="60" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-535" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich zu einem Kurs mehrere Sessions mit Datum, Uhrzeit, Ort, Trainer und Platzzahl anlegen, damit ein Kurs an verschiedenen Terminen und Orten stattfinden kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="5776.07" y="90" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-536" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="6070" y="60" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-537" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Ein Trainer kann nicht zeitgleich in zwei Sessions eingesetzt werden. Am selben Ort findet zur selben Zeit nur eine Session statt. Die Platzzahl ist abhängig vom Ort." vertex="1">
          <mxGeometry height="40" width="295" x="6070" y="80" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-539" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5770" y="180" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-540" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Sessions verschieben oder absagen, damit ich auf Ausfälle und Änderungen reagieren kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="5776.08" y="195" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-541" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6070" y="180" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-542" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Betroffene Teilnehmer und der Trainer werden informiert. Abgesagte Sessions bleiben mit Status „abgesagt” sichtbar." vertex="1">
          <mxGeometry height="40" width="295" x="6070" y="195" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-547" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="5776.08" y="470" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-548" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzer mit der Rolle Admin, Employee oder Trainer anlegen, damit jede Person genau die Funktionen nutzen kann, die sie braucht." vertex="1">
          <mxGeometry height="40" width="282.85" x="5782.15" y="500" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-549" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="6076.08" y="470" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-550" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Vorname, Nachname, E-Mail und Rolle sind Pflicht. Eine E-Mail-Adresse kann nur einmal vergeben werden." vertex="1">
          <mxGeometry height="40" width="282.85" x="6078.58" y="490" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-551" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5776.08" y="590" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-552" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzerdaten und Rollen ändern." vertex="1">
          <mxGeometry height="40" width="282.85" x="5782.16" y="605" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-553" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6076.08" y="590" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-554" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Änderungen sind sofort wirksam. " vertex="1">
          <mxGeometry height="40" width="295" x="6076.08" y="605" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-555" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5776.08" y="680" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-556" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzer deaktivieren, damit ausgeschiedene Personen keinen Zugriff mehr haben" vertex="1">
          <mxGeometry height="40" width="282.85" x="5782.15" y="700" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-557" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="6076.08" y="680" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-558" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Deaktivierte Benutzer können sich nicht anmelden. Bisherige Anmeldungen bleiben einsehbar. Der letzte aktive Admin kann nicht deaktiviert werden. " vertex="1">
          <mxGeometry height="40" width="295" x="6076.08" y="700" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-576" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5776.08" y="825" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-577" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich externe Firmen anlegen und bearbeiten, damit deren Mitarbeiter an unseren Kursen teilnehmen können." vertex="1">
          <mxGeometry height="40" width="282.85" x="5784.65" y="845" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-578" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="6076.08" y="825" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-579" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Firmenname, Ansprechpartner und Kontakt-E-Mail sind Pflicht. Ein Firmenname kann nur einmal vergeben werden. " vertex="1">
          <mxGeometry height="40" width="295" x="6076.08" y="845" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-580" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5776.08" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-581" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Orte (Standort und Raum) verwalten, damit ich Sessions den richtigen Räumen zuordnen kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="5784.65" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-582" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="6076.08" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-583" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Ein Ort hat Name, Adresse, Raum und Platzkapazität. Orte lassen sich deaktivieren, ohne alte Sessions zu verändern. " vertex="1">
          <mxGeometry height="40" width="295" x="6076.08" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-584" parent="1" style="rounded=0;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="880" width="690" x="7550" y="322" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-585" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="330" x="7750" y="352" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-586" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bac8d3;strokeColor=#23445d;" value="" vertex="1">
          <mxGeometry height="150" width="124.31" x="7600" y="352" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-587" parent="1" style="shape=actor;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="120" width="100" x="7612.15" y="367" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-588" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=1" value="Employee" vertex="1">
          <mxGeometry height="40" width="150" x="7760" y="352" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-589" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Nimmt teil an Kursen und erhält Zertikfikate dafür." vertex="1">
          <mxGeometry height="40" width="320" x="7760" y="382" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-590" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="7600" y="532" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-591" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich alle buchbaren Kurse mit Beschreibung ansehen, damit ich passende Weiterbildungen finde." vertex="1">
          <mxGeometry height="40" width="282.85" x="7606.08" y="547" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-592" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="7900" y="532" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-593" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="User Story" vertex="1">
          <mxGeometry height="40" width="112.15" x="7600" y="502" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-594" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Akzeptanzkriterien" vertex="1">
          <mxGeometry height="40" width="130" x="7900" y="502" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-595" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Vergangene Kurse werden nicht angezeigt." vertex="1">
          <mxGeometry height="40" width="295" x="7900" y="547" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-596" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="7600" y="622" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-597" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich zu jedem Kurs die Sessions mit Datum, Ort und freien Plätzen sehen, damit ich einen Termin wählen kann, der zu mir passt." vertex="1">
          <mxGeometry height="40" width="282.85" x="7606.07" y="652" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-598" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="7900" y="622" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-599" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Ausgebuchte Sessions sind erkennbar. Abgesagte Sessions werden nicht zur Anmeldung angeboten." vertex="1">
          <mxGeometry height="70" width="295" x="7900" y="637" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-600" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="90" width="295" x="7600" y="742" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-601" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich mich für eine Session anmelden, damit ich ohne Umweg über die Verwaltung einen Platz bekomme." vertex="1">
          <mxGeometry height="40" width="282.85" x="7606.08" y="767" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-602" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="90" width="295" x="7900" y="742" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-603" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Die Anmeldung gelingt nur bei freien Plätzen. Eine Doppelanmeldung ist nicht möglich. Zeitlich überschneidende Sessions werden abgelehnt." vertex="1">
          <mxGeometry height="40" width="295" x="7900" y="767" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-608" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="7600.01" y="854" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-609" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich mich von einer Session wieder abmelden, damit der Platz für andere frei wird, wenn ich nicht teilnehmen kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="7603.58" y="884" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-610" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="7900" y="854" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-611" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Die Abmeldung ist bis zu einer festgelegten Frist vor Beginn möglich. Der Platz wird sofort wieder frei." vertex="1">
          <mxGeometry height="40" width="282.85" x="7900.01" y="884" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-612" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
