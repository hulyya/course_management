        <mxCell id="pgUvCwgqiw09msVsI5Re-517" parent="1" style="shape=actor;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="120" width="100" x="5862.15" y="-145" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-520" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=1" value="Admin" vertex="1">
          <mxGeometry height="40" width="150" x="6010" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-521" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Plant und verwaltet alles rund um die Kurse" vertex="1">
          <mxGeometry height="40" width="360" x="6010" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-522" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5850" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-524" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Kurse anlegen, ändern und verwalten." vertex="1">
          <mxGeometry height="40" width="282.85" x="5856.08" y="35" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-525" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6150" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-526" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="User Story" vertex="1">
          <mxGeometry height="40" width="112.15" x="5850" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-527" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Akzeptanzkriterien" vertex="1">
          <mxGeometry height="40" width="130" x="6150" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-528" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Titel und Beschreibung sind Pflicht.&amp;nbsp;" vertex="1">
          <mxGeometry height="40" width="295" x="6150" y="35" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-534" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="5850" y="110" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-535" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich zu einem Kurs mehrere Sessions mit Datum, Uhrzeit, Ort, Trainer und Platzzahl anlegen, damit ein Kurs an verschiedenen Terminen und Orten stattfinden kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="5856.07" y="140" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-536" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="6150" y="110" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-537" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Ein Trainer kann nicht zeitgleich in zwei Sessions eingesetzt werden. Am selben Ort findet zur selben Zeit nur eine Session statt. Die Platzzahl passt zur Größe des Ortes." vertex="1">
          <mxGeometry height="40" width="295" x="6150" y="130" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-539" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5850" y="230" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-540" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Sessions verschieben oder absagen, damit ich auf Ausfälle und Änderungen reagieren kann." vertex="1">
          <mxGeometry height="40" width="282.85" x="5856.08" y="245" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-541" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6150" y="230" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-542" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Betroffene Teilnehmer und der Trainer werden informiert. Abgesagte Sessions bleiben mit Status „abgesagt” sichtbar." vertex="1">
          <mxGeometry height="40" width="295" x="6150" y="245" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-543" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5847.5" y="320" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-544" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Kurse anlegen, ändern und verwalten." vertex="1">
          <mxGeometry height="40" width="282.85" x="5853.58" y="335" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-545" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6147.5" y="320" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-546" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Titel und Beschreibung sind Pflicht.&amp;nbsp;" vertex="1">
          <mxGeometry height="40" width="295" x="6147.5" y="335" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-547" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="5847.5" y="460" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-548" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzer mit der Rolle Admin, Employee oder Trainer anlegen, damit jede Person genau die Funktionen nutzen kann, die sie braucht." vertex="1">
          <mxGeometry height="40" width="282.85" x="5853.57" y="490" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-549" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="6147.5" y="460" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-550" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Vorname, Nachname, E-Mail und Rolle sind Pflicht. Eine E-Mail-Adresse kann nur einmal vergeben werden." vertex="1">
          <mxGeometry height="40" width="282.85" x="6150" y="480" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-551" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="5847.5" y="580" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-552" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzerdaten und Rollen ändern." vertex="1">
          <mxGeometry height="40" width="282.85" x="5853.58" y="595" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-553" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="70" width="295" x="6147.5" y="580" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-554" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Änderungen sind sofort wirksam. " vertex="1">
          <mxGeometry height="40" width="295" x="6147.5" y="595" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-555" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5847.5" y="670" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-556" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich Benutzer deaktivieren, damit ausgeschiedene Personen keinen Zugriff mehr haben" vertex="1">
          <mxGeometry height="40" width="282.85" x="5856.07" y="690" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-557" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="6147.5" y="670" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-558" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Deaktivierte Benutzer können sich nicht anmelden. Bisherige Anmeldungen bleiben einsehbar. Der letzte aktive Admin kann nicht deaktiviert werden. " vertex="1">
          <mxGeometry height="40" width="295" x="6147.5" y="690" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-576" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5847.5" y="820" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-577" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Admin&lt;/strong&gt; möchte ich externe Firmen anlegen und bearbeiten, damit deren Mitarbeiter an unseren Kursen teilnehmen können." vertex="1">
          <mxGeometry height="40" width="282.85" x="5856.07" y="840" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-578" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="6147.5" y="820" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-579" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Firmenname, Ansprechpartner und Kontakt-E-Mail sind Pflicht. Ein Firmenname kann nur einmal vergeben werden. " vertex="1">
          <mxGeometry height="40" width="295" x="6147.5" y="840" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-580" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="80" width="295" x="5847.5" y="970" as="geometry" />
        </mxCell>
