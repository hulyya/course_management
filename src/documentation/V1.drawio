        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-597" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich zu jedem Kurs die Sessions mit Datum, Ort und freien Plätzen sehen, damit ich einen Termin wählen kann, der zu mir passt." vertex="1">
          <mxGeometry height="40" width="282.85" x="6576.07" y="140" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-598" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
