        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-599" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Ausgebuchte Sessions sind erkennbar. Abgesagte Sessions werden nicht zur Anmeldung angeboten." vertex="1">
          <mxGeometry height="70" width="295" x="6870" y="125" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-600" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="90" width="295" x="6570" y="230" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-601" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Als &lt;strong&gt;Employee&lt;/strong&gt; möchte ich mich für eine Session anmelden, damit ich ohne Umweg über die Verwaltung einen Platz bekomme." vertex="1">
          <mxGeometry height="40" width="282.85" x="6576.08" y="255" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-602" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="90" width="295" x="6870" y="230" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-603" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Die Anmeldung gelingt nur bei freien Plätzen. Eine Doppelanmeldung ist nicht möglich. Zeitlich überschneidende Sessions werden abgelehnt." vertex="1">
          <mxGeometry height="40" width="295" x="6870" y="255" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-608" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
