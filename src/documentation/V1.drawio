          <mxGeometry height="40" width="282.85" x="6573.58" y="375" as="geometry" />
        </mxCell>
        <mxCell id="pgUvCwgqiw09msVsI5Re-610" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="100" width="295" x="6870" y="342" as="geometry" />
        </mxCell>
